{
  "opencollection": "1.0.0",
  "info": {
    "name": "Chamber Capacity Health API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Service health check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.usechamber.io/v1/health"
          },
          "docs": "Check the health status of the Chamber API service. This endpoint does not require authentication and can be used for monitoring and load balancer health checks."
        }
      ]
    }
  ],
  "bundled": true
}